<p :if={!assigns[:game]} class="py-24 text-center text-muted">Starting a new game…</p>

<div
  :if={assigns[:game]}
  class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:items-start lg:gap-14"
>
  <section
    class="rounded-[2rem] bg-ink px-6 py-8 text-mist sm:px-10 sm:py-10 lg:sticky lg:top-8"
    aria-label="Your codebase"
  >
    <p class="text-6xl leading-none font-extrabold tracking-tight tabular-nums sm:text-7xl">
      {number(@game.sloc)}
    </p>
    <p class="mt-2 text-lg text-lilac">lines of code written</p>

    <button
      id="write-code"
      type="button"
      phx-click="elixir_clicked"
      aria-label="Write a line of code"
      class="mx-auto my-8 block cursor-pointer rounded-full bg-[radial-gradient(closest-side,var(--color-lilac),transparent)] p-10 transition-transform duration-75 select-none hover:scale-105 active:scale-90 focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-amber motion-reduce:transition-none"
    >
      <img class="h-52 sm:h-60" src={~p"/images/elixir.png"} alt="" draggable="false" />
    </button>
    <p class="text-center text-lilac">Click the drop to write a line and earn $1.</p>

    <dl class="mt-8 grid grid-cols-2 gap-6 border-t border-white/15 pt-6">
      <div>
        <dt class="text-sm text-lilac">In the bank</dt>
        <dd class="text-3xl font-bold text-amber tabular-nums">${number(@game.currency)}</dd>
      </div>
      <div>
        <dt class="text-sm text-lilac">Your team writes</dt>
        <dd class="text-3xl font-bold tabular-nums">{number(@locps)} lines/s</dd>
      </div>
    </dl>
  </section>

  <section aria-labelledby="team-heading">
    <h2 id="team-heading" class="text-4xl font-extrabold tracking-tight">Hire a team</h2>
    <p class="mt-2 max-w-prose text-lg text-muted">
      Every hire keeps writing code while you rest your clicking finger.
    </p>

    <ul class="mt-6 divide-y divide-ink/10 border-y border-ink/10">
      <li
        :for={{key, employee} <- @employees}
        class="flex items-center justify-between gap-4 py-4"
      >
        <div>
          <p class="text-xl font-bold">
            {employee["name"]}
            <span
              :if={owned = @game.employee_state[Atom.to_string(key)]["count"]}
              class="ml-2 rounded-full bg-plum px-2.5 py-0.5 align-middle text-sm font-semibold text-white tabular-nums"
            >
              {owned} hired
            </span>
          </p>
          <p class="text-muted">
            <%= if employee["locps"] > 0 do %>
              Writes {employee["locps"]} {if employee["locps"] == 1, do: "line", else: "lines"} per second
            <% else %>
              Multiplies team earnings by {employee["multiplier"]}
            <% end %>
          </p>
        </div>
        <button
          type="button"
          phx-click="employee_bought"
          phx-value-employee={key}
          disabled={@game.currency < employee["cost"]}
          class="shrink-0 cursor-pointer sm:min-w-36 rounded-full bg-amber px-5 py-2.5 font-bold text-ink tabular-nums hover:bg-ink hover:text-amber focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-plum disabled:cursor-not-allowed disabled:bg-transparent disabled:font-medium disabled:text-muted disabled:ring-1 disabled:ring-ink/20 disabled:ring-inset"
        >
          Hire for ${number(employee["cost"])}
        </button>
      </li>
    </ul>

    <p class="mt-6 max-w-prose text-sm text-muted">
      Your game is saved at this page's address. Bookmark it to keep playing later.
    </p>
  </section>
</div>
